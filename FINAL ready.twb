      <aliases enabled='yes' />
      <column caption='Size' datatype='integer' name='[Calculation_0838444655509504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SIZE()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Ratio' datatype='real' name='[Calculation_0838444671053827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([country])/SUM({FIXED[job_role]:COUNT([country])})' />
      </column>
      <column caption='Skill' datatype='real' name='[Calculation_0838444676710404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[skill_demand_growth_percent]*[skill_gap_index]' />
      </column>
      <column caption='AI Risk' datatype='string' name='[Calculation_0838444696743941]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([ai_replacement_score]) &gt;= 10000 THEN &quot;Critical Risk&quot;&#13;&#10;ELSEIF SUM([ai_replacement_score]) &gt;= 7000 THEN &quot;High Risk&quot;&#13;&#10;ELSEIF SUM([ai_replacement_score]) &gt;= 4000 THEN &quot;Moderate Risk&quot;&#13;&#10;ELSE &quot;Low Risk&quot;&#13;&#10;END' />
      </column>
      <column caption='case' datatype='string' datatype-customized='true' name='[Calculation_0838444700168198]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [industry]&#13;&#10;    WHEN &quot;Transportation&quot; THEN &quot;High Volatility&quot;&#13;&#10;    WHEN &quot;Retail&quot; THEN &quot;High Volatility&quot;&#13;&#10;    WHEN &quot;Healthcare&quot; THEN &quot;Medium Volatility&quot;&#13;&#10;    WHEN &quot;Manufacturing&quot; THEN &quot;Medium Volatility&quot;&#13;&#10;    WHEN &quot;Energy&quot; THEN &quot;Low Volatility&quot;&#13;&#10;    WHEN &quot;Education&quot; THEN &quot;Low Volatility&quot;&#13;&#10;    ELSE &quot;Standard&quot;&#13;&#10;END' />
      </column>
      <column caption='StringFun' datatype='string' name='[Calculation_0838444701933575]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(LEFT([industry], 3))' />
      </column>
      <column caption='Max' datatype='real' name='[Calculation_0838444709933064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([reskilling_urgency_score])' />
      </column>
      <column caption='Min' datatype='real' name='[Calculation_0838444711915529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([reskilling_urgency_score])' />
      </column>
